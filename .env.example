# Copy these into your host's protected environment-variable settings.
# Never commit real database or mail credentials.
APP_ENV=production
APP_URL=https://your-domain.example
CONTACT_EMAIL=
MAIL_FROM=

# Accounts and saved invoices are disabled until a MySQL/MariaDB database is configured.
DB_DSN=mysql:host=127.0.0.1;dbname=utilityhub;charset=utf8mb4
DB_USER=
DB_PASSWORD=
